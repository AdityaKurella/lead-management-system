        "jsCode": "const config = {\n  ownerEmail: 'OWNER_EMAIL@example.com', bookingUrl: 'https://example.com',\n  sheetId: 'REPLACE_WITH_GOOGLE_SHEET_ID', sheetName: 'Leads', errorSheetName: 'Errors',\n  mode: 'HUMAN_APPROVAL', timezone: 'Asia/Kolkata', followUp1Days: 1, followUp2Days: 3, followUp3Days: 7,\n  aiApiUrl: 'https://generativelanguage.googleapis.com/v1beta/models', aiModel: 'gemini-3.5-flash-lite',\n  senderEmail: 'OWNER_EMAIL@example.com', n8nBaseUrl: 'https://YOUR_N8N_HOST', approveSendPath: 'approve-send'\n};\nconst body = $json.body || $json || {};\nconst clean = v => v == null ? '' : String(v).trim();\nconst firstName=clean(body.firstName), lastName=clean(body.lastName), email=clean(body.email).toLowerCase();\nconst lead={leadId:'',timestamp:new Date().toISOString(),firstName,lastName,fullName:[firstName,lastName].filter(Boolean).join(' '),email,\nphone:clean(body.phone),company:clean(body.company),website:clean(body.website),message:clean(body.message),service:clean(body.service),source:clean(body.source)||'Website',\nstatus:'NEW',leadScore:0,leadPriority:'',intent:'',fit:'',qualificationReason:'',aiSummary:'',recommendedAction:'',firstContactedAt:'',lastContactedAt:'',nextFollowUpAt:'',followUpCount:0,replyDetected:false,optedOut:false};\nlead.leadId='LEAD-'+Date.now().toString(36).toUpperCase()+Math.random().toString(36).slice(2,8).toUpperCase();\nreturn [{json:{config,lead,ai:{},validation:{},approvalToken:''}}];"
