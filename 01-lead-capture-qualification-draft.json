    {
      "parameters": {
        "jsCode": "const lead = $json.lead;\nconst prompt = `You are a conservative B2B lead qualification analyst. Using ONLY the information supplied below, score this lead. Do not invent facts. Respond with ONLY a JSON object, no markdown, matching exactly this shape: {\\\"score\\\":0,\\\"priority\\\":\\\"HOT|WARM|COLD\\\",\\\"intent\\\":\\\"HIGH|MEDIUM|LOW\\\",\\\"fit\\\":\\\"GOOD|POSSIBLE|POOR\\\",\\\"reason\\\":\\\"\\\",\\\"summary\\\":\\\"\\\",\\\"recommendedAction\\\":\\\"\\\"}. Scoring guide: 80-100 HOT, 50-79 WARM, 0-49 COLD. Consider urgency, budget signals, clarity of the service request, and business fit.\\n\\nName: ${lead.fullName || '(not provided)'}\\nCompany: ${lead.company || '(not provided)'}\\nService requested: ${lead.service || '(not provided)'}\\nWebsite: ${lead.website || '(not provided)'}\\nMessage: ${lead.message || '(not provided)'}`;\nreturn [{ json: { ...$json, aiPrompt: prompt } }];"
      },
