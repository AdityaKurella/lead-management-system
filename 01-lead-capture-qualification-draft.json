    {
      "parameters": {
        "jsCode": "const prev = $('Build Qualification Prompt').first().json;\nlet parsed = null;\nlet parseError = '';\ntry {\n  const text = $json.candidates[0].content.parts[0].text;\n  parsed = JSON.parse(text);\n} catch (e) {\n  parseError = 'Gemini qualification response could not be parsed: ' + e.message;\n}\nif (!parsed || typeof parsed.score !== 'number') {\n  parseError = parseError || 'Gemini qualification response missing required fields';\n  parsed = { score: 0, priority: 'COLD', intent: 'LOW', fit: 'POOR', reason: 'AI qualification failed - needs manual review', summary: '', recommendedAction: 'Manual review required' };\n}\nreturn [{ json: { ...prev, ai: { ...prev.ai, qualification: parsed }, qualificationError: parseError } }];"
