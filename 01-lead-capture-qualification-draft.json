      "parameters": {
        "jsCode": "const q = $json.ai.qualification;\nlet score = Math.max(0, Math.min(100, Number(q.score) || 0));\nlet priority = score >= 80 ? 'HOT' : (score >= 50 ? 'WARM' : 'COLD');\nconst lead = {\n  ...$json.lead,\n  status: 'QUALIFIED',\n  leadScore: score,\n  leadPriority: priority,\n  intent: q.intent || '',\n  fit: q.fit || '',\n  qualificationReason: q.reason || '',\n  aiSummary: q.summary || '',\n  recommendedAction: q.recommendedAction || ''\n};\nreturn [{ json: { ...$json, lead } }];"
