    {
      "parameters": {
        "jsCode": "const original=$('Has Valid Email + Message?').first().json;\nconst rows=$input.all(); const match=rows.length ? rows[0].json : null;\nlet lead={...original.lead}; let isDuplicate=false; let existingStatus='NEW';\nif(match && match['Lead ID']){ isDuplicate=true; existingStatus=match['Status']||'NEW'; lead={...lead,leadId:match['Lead ID'],\n firstName:lead.firstName||match['First Name']||'',lastName:lead.lastName||match['Last Name']||'',company:lead.company||match['Company']||'',website:lead.website||match['Website']||'',message:lead.message||match['Message']||'',service:lead.service||match['Service']||'',\n status:existingStatus,followUpCount:Number(match['Follow-Up Count']||0),replyDetected:String(match['Reply Detected']).toLowerCase()==='true',optedOut:String(match['Opted Out']).toLowerCase()==='true',firstContactedAt:match['First Contacted At']||'',lastContactedAt:match['Last Contacted At']||'',nextFollowUpAt:match['Next Follow-Up At']||''};\n lead.fullName=[lead.firstName,lead.lastName].filter(Boolean).join(' ');\n}\nconst alreadyProcessed=isDuplicate && existingStatus!=='NEW';\nreturn [{json:{...original,lead,isDuplicate,alreadyProcessed}}];"
