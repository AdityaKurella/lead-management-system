      "typeVersion": 4.5,
      "position": [
        224,
        1088
      ]
    },
    {
      "parameters": {
        "jsCode": "const req=$('Config + Extract Params').first().json; const rows=$input.all(); const row=rows.length?rows[0].json:null; if(!row||!row['Lead ID']) return [{json:{...req,eligible:false,reason:'Lead not found'}}]; const reasons=[]; if(String(row['Approval Token']||'')!==req.token) reasons.push('Invalid or already-consumed token'); if((row.Status||'')!=='PENDING_APPROVAL') reasons.push('Lead is not pending approval'); if(String(row['Opted Out']).toLowerCase()==='true') reasons.push('Lead opted out'); if(String(row['Reply Detected']).toLowerCase()==='true') reasons.push('Lead already replied'); if(!row['Draft Subject']||!row['Draft Body']) reasons.push('No draft found'); return [{json:{...req,row,eligible:reasons.length===0,reason:reasons.join('; ')}}];"
      },
      "id": "5eb8ddc9-474e-5037-ab59-81b8af1e09f7",
