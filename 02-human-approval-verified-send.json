    {
      "parameters": {
        "jsCode": "const now=new Date().toISOString(); const row=$json.row; const next=new Date(Date.now()+$json.config.followUp1Days*86400000).toISOString(); return [{json:{...$json,updateRow:{'Lead ID':row['Lead ID'],'Updated At':now,'Status':'CONTACTED','First Contacted At':row['First Contacted At']||now,'Last Contacted At':now,'Next Follow-Up At':next,'Follow-Up Count':0,'Approval Token':''}}}];"
      },
