      "parameters": {
        "jsCode": "const config={ownerEmail:'OWNER_EMAIL@example.com',bookingUrl:'https://example.com',sheetId:'REPLACE_WITH_GOOGLE_SHEET_ID',sheetName:'Leads',errorSheetName:'Errors',mode:'HUMAN_APPROVAL',timezone:'Asia/Kolkata',followUp1Days:1,followUp2Days:3,followUp3Days:7,aiApiUrl:'https://generativelanguage.googleapis.com/v1beta/models',aiModel:'gemini-3.5-flash-lite',senderEmail:'OWNER_EMAIL@example.com',n8nBaseUrl:'https://YOUR_N8N_HOST',approveSendPath:'approve-send'}; const q=$json.query||{}; return [{json:{config,leadId:String(q.leadId||'').trim(),token:String(q.token||'').trim()}}];"
