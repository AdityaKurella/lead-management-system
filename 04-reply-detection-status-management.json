        "emailType": "text",
        "message": "=Status: {{ $json.updateRow['Status'] }}\nSentiment: {{ $json.classification.sentiment }}\nIntent: {{ $json.classification.intent }}\nSummary: {{ $json.classification.summary }}\nRecommended action: {{ $json.classification.recommendedAction }}",
        "options": {}
