        688,
        2464
      ]
    },
    {
      "parameters": {
        "jsCode": "const config={ownerEmail:'OWNER_EMAIL@example.com',bookingUrl:'https://example.com',sheetId:'REPLACE_WITH_GOOGLE_SHEET_ID',sheetName:'Leads',errorSheetName:'Errors',mode:'HUMAN_APPROVAL',timezone:'Asia/Kolkata',followUp1Days:1,followUp2Days:3,followUp3Days:7,aiApiUrl:'https://generativelanguage.googleapis.com/v1beta/models',aiModel:'gemini-3.5-flash-lite',senderEmail:'OWNER_EMAIL@example.com',n8nBaseUrl:'https://YOUR_N8N_HOST',approveSendPath:'approve-send'}; const msg=$json; const from=(msg.from&&msg.from.value&&msg.from.value[0]&&msg.from.value[0].address)||msg.From||''; const senderEmail=String(from).toLowerCase().trim(); if(senderEmail===config.senderEmail.toLowerCase()) return []; return [{json:{config,senderEmail,snippet:msg.snippet||msg.textPlain||msg.text||'',subject:msg.subject||msg.Subject||''}}];"
      },
      "id": "b217af39-3c18-5f45-90f2-958c14071223",
      "name": "Config + Extract Sender",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        944,
        2464
      ]
    },
    {
      "parameters": {
        "operation": "search",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "Email",
              "lookupValue": "={{ $json.senderEmail }}"
            }
          ]
        }
      },
      "id": "1acd2007-1961-50cf-a023-dc1c7974845e",
      "name": "Find Lead By Email",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1200,
        2464
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          },
          "conditions": [
            {
              "id": "l1",
              "leftValue": "={{ $json['Lead ID'] }}",
              "rightValue": "",
              "operator": {
