                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "92bf8196-8121-5155-a6c3-15bf43543e98",
      "name": "Lead Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1456,
        2480
      ]
    },
    {
      "parameters": {},
      "id": "3a2fb381-48e8-55b3-b968-7c30b324f778",
      "name": "No Matching Lead - Stop",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1824,
        2656
      ]
    },
    {
      "parameters": {
        "jsCode": "const prev = $('Config + Extract Sender').first().json;\nconst row = $json;\nconst prompt = `Classify this email reply from a sales lead. Respond with ONLY JSON: {\\\"replied\\\":true,\\\"sentiment\\\":\\\"POSITIVE|NEUTRAL|NEGATIVE\\\",\\\"intent\\\":\\\"INTERESTED|QUESTION|NOT_INTERESTED|UNSUBSCRIBE|OTHER\\\",\\\"summary\\\":\\\"\\\",\\\"recommendedAction\\\":\\\"\\\"}.\\n\\nOriginal service requested: ${row['Service'] || '(not provided)'}\\nReply subject: ${prev.subject}\\nReply text: ${prev.snippet}`;\nreturn [{ json: { config: prev.config, row, aiPrompt: prompt } }];"
      },
      "id": "5e958e50-77f2-5878-942b-622990647879",
      "name": "Build Classification Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1776,
        2368
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.config.aiApiUrl }}/{{ $json.config.aiModel }}:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({contents:[{parts:[{text: $json.aiPrompt}]}], generationConfig:{responseMimeType:'application/json', temperature:0.3}}) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "8e2f0572-66be-54fb-8a59-2e348a9506a1",
      "name": "Gemini - Classify Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2016,
        2368
      ]
    },
    {
      "parameters": {
        "jsCode": "const prev = $('Build Classification Prompt').first().json;\nlet parsed = null; let err = '';\ntry {\n  const text = $json.candidates[0].content.parts[0].text;\n  parsed = JSON.parse(text);\n} catch (e) { err = 'Reply classification failed to parse: ' + e.message; }\nif (!parsed || !parsed.intent) {\n  err = err || 'Reply classification missing intent';\n  parsed = { replied: true, sentiment: 'NEUTRAL', intent: 'OTHER', summary: 'Could not auto-classify - manual review needed', recommendedAction: 'Manual review' };\n}\nreturn [{ json: { config: prev.config, row: prev.row, classification: parsed, classificationError: err } }];"
      },
      "id": "7fc7b05a-4bbf-5687-adba-f31cdfd42f39",
      "name": "Parse Classification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2256,
        2368
      ]
    },
    {
      "parameters": {
        "jsCode": "const c = $json.classification;\nconst row = $json.row;\nconst now = new Date().toISOString();\nlet status = 'REPLIED';\nlet optedOut = String(row['Opted Out']).toLowerCase() === 'true';\nlet notifyOwner = false;\n\nif (c.intent === 'UNSUBSCRIBE') {\n  status = 'DO_NOT_CONTACT';\n  optedOut = true;\n  notifyOwner = true;\n} else if (c.intent === 'INTERESTED' || c.sentiment === 'POSITIVE') {\n  status = 'REPLIED_POSITIVE';\n  notifyOwner = true;\n} else if (c.intent === 'QUESTION') {\n  status = 'REPLIED';\n  notifyOwner = true;\n} else {\n  status = 'REPLIED';\n  notifyOwner = false;\n}\n\nreturn [{ json: { ...$json, notifyOwner, updateRow: {\n  'Lead ID': row['Lead ID'],\n  'Updated At': now,\n  'Status': status,\n  'Reply Detected': true,\n  'Opted Out': optedOut,\n  'Next Follow-Up At': '',\n  'AI Summary': c.summary || row['AI Summary'] || ''\n} } }];"
      },
      "id": "3e2e20a9-c403-503a-8829-54f1e11de23c",
      "name": "Determine Status Update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2496,
        2368
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          },
          "conditions": [
            {
              "id": "n1",
              "leftValue": "={{ $json.notifyOwner }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b950f8f4-2176-5042-8126-b3c4b38cc4a1",
      "name": "Notify Owner?",
